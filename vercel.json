{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy.html"
    },
    {
      "source": "/:path((?!api).*)*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/ponto-ausencia",
      "schedule": "0 10,14 * * 1-6"
    },
    {
      "path": "/api/cron/checklists-delayed",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/ponto-diario",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/ponto-fechamento",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/modelos-rosto/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}

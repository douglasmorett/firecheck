{
  "functions": {
    "server/*.js": {
      "runtime": "vercel-node@latest"
    }
  },
  "rewrites": [
    { "source": "/api/login", "destination": "/server/index.js" },
    { "source": "/api/(.*)", "destination": "/server/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
